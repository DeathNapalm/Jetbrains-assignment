        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"youtrack\", cpu=\"total\"}[30s]))",
          "refId": "B",
          "legendFormat": "CPU (kernel mode)",
          "hide": true
        }
      ],
      "title": "CPU Usage — cores consumed (rate over 30s)",
      "type": "timeseries"
    },

