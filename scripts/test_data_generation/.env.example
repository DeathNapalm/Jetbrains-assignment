# YouTrack API Configuration
YOUTRACK_URL=http://youtrack:8080
YOUTRACK_TOKEN=perm:your-permanent-token-here

# Test Data Configuration
TOTAL_USERS=100
TOTAL_ISSUES=100000

# Parallelization Configuration
NUM_WORKERS=4
ISSUES_PER_BATCH=100
BATCH_DELAY_SECONDS=0.5

# Logging Configuration
LOG_LEVEL=INFO

# Database Backup
CREATE_BACKUP_AFTER=true
