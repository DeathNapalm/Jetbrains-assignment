# Custom JVM options for YouTrack application process.
# Enables remote JMX for Prometheus jmx-exporter sidecar.
-Dcom.sun.management.jmxremote=true
-Dcom.sun.management.jmxremote.port=39010
-Dcom.sun.management.jmxremote.rmi.port=39010
-Dcom.sun.management.jmxremote.authenticate=false
-Dcom.sun.management.jmxremote.ssl=false
-Dcom.sun.management.jmxremote.local.only=false
-Djava.rmi.server.hostname=youtrack
-Xms768m
-Xmx2048m
